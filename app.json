{
  "expo": {
    "name": "Khit Slik POS",
    "slug": "khit-slik-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.otas.khit-slik-pos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F1FB8",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.otas.khit-slik-pos",
      "permissions": [
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "runtimeVersion": {
        "policy": "fingerprint"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow AutoShop to save receipt images to Photos.",
          "granularPermissions": []
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1F1FB8",
          "defaultChannel": "low-stock-alerts"
        }
      ],
      "./plugins/withBluetoothPermissions",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F1FB8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "scheme": "khit-slik-pos",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f5f0b04-393d-4cff-a248-515681886b53"
      }
    },
    "owner": "aaog2"
  }
}
